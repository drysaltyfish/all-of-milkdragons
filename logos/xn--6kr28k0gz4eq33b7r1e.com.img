<script>
        (function(){
            var notice_index=0;
            var $top=$(".jiangzuo-top img");
            var $foot=$(".jiangzuo-foot");
            var $bt=$(".jiangzuo-bt");
            function switch_notice(){
                notice_index=(notice_index+1)%3;
                $top.hide();
                $foot.hide();
                $bt.hide();
                $top.eq(notice_index).show();
                $foot.eq(notice_index).show();
                $bt.eq(notice_index).show();
            };
            var timer_notice=setInterval(function(){
                switch_notice();
            },4500);
        })();
    </script>
    
